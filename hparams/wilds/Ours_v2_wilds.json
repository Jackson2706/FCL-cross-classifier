{
    "algorithm": "Ours_v2",
    "dataset": "WILDS",
    "num_classes": 2,
    "model": "ResNet18",
    "model_str": "resnet18",
    "device": "cuda",
    "device_id": "0",
    
    "log": true,
    "offlog": false,
    "wandb": false,
    "out_folder": "out",
    "note": "Ours_v2_Basic_Setup",

    "optimizer": "adam",
    "batch_size": 64,
    "local_learning_rate": 0.05,
    "learning_rate_decay": true,
    "learning_rate_decay_gamma": 0.99,

    "num_clients": 50,
    "join_ratio": 0.2,
    "random_join_ratio": false,
    "client_drop_rate": 0.0,
    "prev": 0,
    "times": 1,

    "global_rounds": 50,
    "local_epochs": 5,
    "eval_gap": 1,
    "time_threthold": 10000,

    "num_tasks": 5,
    "cpt": 20,

    "g_lr": 0.01,
    "g_steps": 2000,
    "replay_weight": 25,
    "nz": 256,
    "latent_dim": 256,

    "kd": 0.5,
    
    "adv": 0.0, 
    "bn": 1.0,
    "oh": 1.0
}